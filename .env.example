# Copy to .env for local development (docker-compose Postgres) and fill in the rest.
# In production, set these as real environment variables/secrets on the host — never commit .env.

# --- Database (Neon Postgres) -----------------------------------------------
# Pooled connection (via PgBouncer) — used by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/azurehijabs"
# Direct connection (no pooler) — used by Prisma Migrate.
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/azurehijabs"

# --- Auth --------------------------------------------------------------------
# Random 32+ byte secret used to sign access/refresh tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"

# --- Razorpay ------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-me"
RAZORPAY_WEBHOOK_SECRET="replace-me"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="AzureHijabs <orders@azurehijabs.com>"

# --- Object storage (Cloudflare R2, S3-compatible) --------------------------
R2_ACCOUNT_ID="replace-me"
R2_ACCESS_KEY_ID="replace-me"
R2_SECRET_ACCESS_KEY="replace-me"
R2_BUCKET="azurehijabs"
R2_PUBLIC_URL="https://cdn.azurehijabs.com"

# --- Rate limiting (Upstash Redis) -------------------------------------------
UPSTASH_REDIS_REST_URL="https://xxxxxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-me"

# --- Error tracking (optional) ----------------------------------------------
SENTRY_DSN=""
